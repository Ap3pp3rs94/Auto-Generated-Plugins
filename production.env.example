# Francis Factory production environment template.
#
# Copy to an environment file outside git, adjust values, then load it from your
# process manager or shell before running:
#
#   set -a
#   . ./production.env
#   set +a
#   python -m factory_runner

FRANCIS_FACTORY_USER_ID=francis-factory

# Continuous side-project mode. Set to false and use MAX_PLUGINS for batches.
FRANCIS_FACTORY_LOOP=true
FRANCIS_FACTORY_MAX_PLUGINS=
FRANCIS_FACTORY_SLEEP_SECONDS=15

# Local Ollama model settings.
FRANCIS_FACTORY_MODEL=llama3.1:8b
FRANCIS_FACTORY_TEMPERATURE=0.25
FRANCIS_FACTORY_MAX_TOKENS=1024
FRANCIS_FACTORY_TIMEOUT_SECONDS=240

# Duplicate/category guardrails.
FRANCIS_FACTORY_NO_CATEGORY_ROTATION=false
FRANCIS_FACTORY_MAX_PER_CATEGORY=

# Optional Station D evaluation hooks.
FRANCIS_FACTORY_EVALUATION_ENABLED=false
FRANCIS_FACTORY_EVALUATION_THRESHOLD=0.65
FRANCIS_FACTORY_EVALUATION_PROFILE=
FRANCIS_FACTORY_EVALUATION_ENFORCE=false

# GitHub publish. Default behavior commits each validated plugin file and
# pushes it to origin/main. Set NO_GITHUB_PUBLISH=true for local-only runs.
FRANCIS_FACTORY_NO_GITHUB_PUBLISH=false
FRANCIS_FACTORY_GITHUB_REMOTE=origin
FRANCIS_FACTORY_GITHUB_BRANCH=main

# DEBUG is useful during Station B prompt work. INFO is better for unattended runs.
FRANCIS_FACTORY_LOG_LEVEL=INFO
