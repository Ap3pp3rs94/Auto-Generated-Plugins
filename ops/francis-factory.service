[Unit]
Description=Francis autonomous AI plugin factory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/Auto-Generated-Plugins
EnvironmentFile=-/path/to/Auto-Generated-Plugins/production.env
ExecStart=/path/to/Auto-Generated-Plugins/.venv/bin/python -m factory_runner
Restart=on-failure
RestartSec=20
TimeoutStopSec=30

# Keep side-project failures contained.
Nice=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
